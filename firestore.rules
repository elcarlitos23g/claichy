rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared hardened primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserPlaylist
    function isValidUserPlaylist(data, playlistId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'description', 'coverUrl', 'color',
          'isOfflineAvailable', 'author', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'description', 'coverUrl', 'color',
          'isOfflineAvailable', 'author', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == playlistId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.description is string && data.description.size() <= 400
        && data.coverUrl is string && data.coverUrl.size() <= 500
        && data.color is string && data.color.size() <= 32
        && data.isOfflineAvailable is bool
        && data.author is string && data.author.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: PlaylistTrack
    function isValidPlaylistTrack(data, playlistId) {
      return data.keys().hasAll([
          'id', 'playlistId', 'ownerId', 'title', 'artist', 'album',
          'duration', 'youtubeId', 'coverUrl', 'genre', 'addedAt', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'playlistId', 'ownerId', 'title', 'artist', 'album',
          'duration', 'youtubeId', 'coverUrl', 'genre', 'addedAt', 'createdAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 160
        && data.playlistId is string && data.playlistId == playlistId && isValidId(data.playlistId)
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.artist is string && data.artist.size() >= 1 && data.artist.size() <= 160
        && data.album is string && data.album.size() <= 160
        && data.duration is number && data.duration >= 0 && data.duration <= 86400
        && data.youtubeId is string && data.youtubeId.size() <= 64
        && data.coverUrl is string && data.coverUrl.size() <= 500
        && data.genre is string && data.genre.size() <= 80
        && data.addedAt is string && data.addedAt.size() <= 40
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: LikedSong
    function isValidLikedSong(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'artist', 'album',
          'duration', 'youtubeId', 'coverUrl', 'genre', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'artist', 'album',
          'duration', 'youtubeId', 'coverUrl', 'genre', 'createdAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 160
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.artist is string && data.artist.size() >= 1 && data.artist.size() <= 160
        && data.album is string && data.album.size() <= 160
        && data.duration is number && data.duration >= 0 && data.duration <= 86400
        && data.youtubeId is string && data.youtubeId.size() <= 64
        && data.coverUrl is string && data.coverUrl.size() <= 500
        && data.genre is string && data.genre.size() <= 80
        && data.createdAt is timestamp;
    }

    // User Profiles (strictly owner-isolated)
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;

      // User Playlists
      match /playlists/{playlistId} {
        allow get: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(playlistId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
        allow list: if isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(playlistId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserPlaylist(incoming(), playlistId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(playlistId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && isValidUserPlaylist(incoming(), playlistId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'coverUrl', 'color', 'isOfflineAvailable', 'author', 'updatedAt'
          ]);
        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(playlistId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;

        // Playlist Tracks (Master Gate checks parent playlist)
        match /tracks/{trackId} {
          allow get: if isVerifiedUser()
            && isValidId(userId)
            && isValidId(playlistId)
            && isValidId(trackId)
            && isOwner(userId)
            && existing().ownerId == request.auth.uid
            && get(/databases/$(database)/documents/users/$(userId)/playlists/$(playlistId)).data.ownerId == request.auth.uid;
          allow list: if isVerifiedUser()
            && isValidId(userId)
            && isValidId(playlistId)
            && isOwner(userId)
            && resource.data.ownerId == request.auth.uid;
          allow create: if isVerifiedUser()
            && isValidId(userId)
            && isValidId(playlistId)
            && isValidId(trackId)
            && isOwner(userId)
            && exists(/databases/$(database)/documents/users/$(userId)/playlists/$(playlistId))
            && get(/databases/$(database)/documents/users/$(userId)/playlists/$(playlistId)).data.ownerId == request.auth.uid
            && isValidPlaylistTrack(incoming(), playlistId)
            && incoming().createdAt == request.time;
          allow update: if false;
          allow delete: if isVerifiedUser()
            && isValidId(userId)
            && isValidId(playlistId)
            && isValidId(trackId)
            && isOwner(userId)
            && existing().ownerId == request.auth.uid
            && get(/databases/$(database)/documents/users/$(userId)/playlists/$(playlistId)).data.ownerId == request.auth.uid;
        }
      }

      // Liked Songs (Tus Me Gusta)
      match /likedSongs/{likedId} {
        allow get: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(likedId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
        allow list: if isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(likedId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidLikedSong(incoming())
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(likedId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
      }
    }
  }
}
